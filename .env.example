# Copy to .env and fill in. deploy.sh will offer to create this for you.
# .env is gitignored - never commit real addresses or keys.

# Nearest to the Fastly LHR/LCY points of presence fronting the FPL API.
AWS_REGION=eu-west-2

SEASON=2026-27

# Must be verified in SES before anything sends. deploy.sh creates the identity
# and tells you to click the confirmation link.
EMAIL_FROM=fplbot@example.com

# Comma-separated. In the SES sandbox each recipient must be verified too.
EMAIL_TO=you@example.com

# Where CloudWatch alarms go. Blank disables the alarm topic entirely.
ALARM_EMAIL=you@example.com

# Embedded in our User-Agent so a site operator can reach us rather than
# silently blocking our IP range.
CONTACT_URL=https://github.com/MasonGallagher/fplBot

# Optional. SSM Parameter Store name (SecureString) holding The Odds API key.
# Leave blank to skip the source - ClubElo covers 1X2 and clean sheets, so the
# only thing lost is player-level goalscorer pricing.
ODDS_API_KEY_PARAMETER=

# ---------------------------------------------------------------------------
# Pipeline settings - only needed for ./deploy.sh --pipeline
# ---------------------------------------------------------------------------
# Create once in the console: Developer Tools -> Settings -> Connections.
# The GitHub OAuth handshake cannot be automated.
GITHUB_CONNECTION_ARN=
GITHUB_REPOSITORY=MasonGallagher/fplBot
GITHUB_BRANCH=main

# Optional. Where CodePipeline sends build failures and the manual-approval
# notice. Leave unset and it follows ALARM_EMAIL, which is almost always what
# you want. Set it only to route deploy chatter somewhere different from the
# runtime alarms, or to "-" to disable pipeline notifications entirely.
# NOTIFICATION_EMAIL=
